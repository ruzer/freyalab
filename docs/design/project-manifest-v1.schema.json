{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "$ref": "#/$defs/__schema0"
    },
    "version": {
      "$ref": "#/$defs/__schema1"
    },
    "id": {
      "$ref": "#/$defs/__schema2"
    },
    "name": {
      "$ref": "#/$defs/__schema3"
    },
    "createdAt": {
      "$ref": "#/$defs/__schema4"
    },
    "sources": {
      "$ref": "#/$defs/__schema5"
    },
    "recipes": {
      "$ref": "#/$defs/__schema10"
    },
    "results": {
      "$ref": "#/$defs/__schema19"
    }
  },
  "required": [
    "format",
    "version",
    "id",
    "name",
    "createdAt",
    "sources",
    "recipes",
    "results"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "freyalab-project"
    },
    "__schema1": {
      "type": "number",
      "const": 1
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "__schema3": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "__schema4": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "__schema5": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema2"
          },
          "path": {
            "allOf": [
              {
                "pattern": "^[^\\0]+$"
              },
              {
                "pattern": "\\.[cCtT][sS][vV]$"
              }
            ],
            "$ref": "#/$defs/__schema6"
          },
          "external": {
            "type": "boolean"
          },
          "protection": {
            "type": "string",
            "const": "readonly"
          },
          "bytes": {
            "$ref": "#/$defs/__schema7"
          },
          "sha256": {
            "$ref": "#/$defs/__schema8"
          },
          "registeredAt": {
            "$ref": "#/$defs/__schema4"
          },
          "quick": {
            "type": "object",
            "properties": {
              "mtimeMs": {
                "type": "number"
              },
              "headSha256": {
                "$ref": "#/$defs/__schema8"
              },
              "tailSha256": {
                "$ref": "#/$defs/__schema8"
              }
            },
            "required": [
              "mtimeMs",
              "headSha256",
              "tailSha256"
            ],
            "additionalProperties": false
          },
          "format": {
            "type": "object",
            "properties": {
              "encoding": {
                "type": "string",
                "enum": [
                  "utf8",
                  "utf16le",
                  "win1252"
                ]
              },
              "bom": {
                "type": "boolean"
              },
              "delimiter": {
                "type": "string",
                "enum": [
                  ",",
                  ";",
                  "\t",
                  "|"
                ]
              },
              "header": {
                "type": "boolean"
              },
              "eol": {
                "type": "string",
                "enum": [
                  "\n",
                  "\r\n",
                  "\r"
                ]
              },
              "finalEol": {
                "type": "boolean"
              }
            },
            "required": [
              "encoding",
              "bom",
              "delimiter",
              "header",
              "eol",
              "finalEol"
            ],
            "additionalProperties": false
          },
          "schema": {
            "type": "object",
            "properties": {
              "sha256": {
                "$ref": "#/$defs/__schema8"
              },
              "columns": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema9"
                }
              }
            },
            "required": [
              "sha256",
              "columns"
            ],
            "additionalProperties": false
          },
          "history": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema8"
            }
          }
        },
        "required": [
          "id",
          "path",
          "external",
          "protection",
          "bytes",
          "sha256",
          "registeredAt",
          "quick",
          "format",
          "schema"
        ],
        "additionalProperties": false
      }
    },
    "__schema6": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768,
      "pattern": "^[^\\0]+$"
    },
    "__schema7": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema8": {
      "type": "string",
      "pattern": "^[a-f\\d]{64}$"
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "position": {
          "minimum": 1,
          "$ref": "#/$defs/__schema7"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "position",
        "name"
      ],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema2"
              },
              "name": {
                "$ref": "#/$defs/__schema3"
              },
              "sourceSha256": {
                "$ref": "#/$defs/__schema8"
              },
              "semantics": {
                "$ref": "#/$defs/__schema11"
              },
              "steps": {
                "$ref": "#/$defs/__schema12"
              },
              "createdAt": {
                "$ref": "#/$defs/__schema4"
              },
              "sourceId": {
                "$ref": "#/$defs/__schema2"
              }
            },
            "required": [
              "id",
              "name",
              "sourceSha256",
              "semantics",
              "steps",
              "createdAt",
              "sourceId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema2"
              },
              "name": {
                "$ref": "#/$defs/__schema3"
              },
              "sourceSha256": {
                "$ref": "#/$defs/__schema8"
              },
              "semantics": {
                "$ref": "#/$defs/__schema11"
              },
              "steps": {
                "$ref": "#/$defs/__schema12"
              },
              "createdAt": {
                "$ref": "#/$defs/__schema4"
              },
              "baseRecipeId": {
                "$ref": "#/$defs/__schema2"
              }
            },
            "required": [
              "id",
              "name",
              "sourceSha256",
              "semantics",
              "steps",
              "createdAt",
              "baseRecipeId"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "__schema11": {
      "minimum": 1,
      "$ref": "#/$defs/__schema7"
    },
    "__schema12": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "filter"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "all",
                  "any"
                ]
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "column": {
                      "$ref": "#/$defs/__schema9"
                    },
                    "op": {
                      "type": "string",
                      "enum": [
                        "contains",
                        "equals",
                        "notEquals",
                        "starts",
                        "ends",
                        "empty",
                        "notEmpty",
                        "greater",
                        "greaterEqual",
                        "less",
                        "lessEqual",
                        "dateBefore",
                        "dateOn",
                        "dateAfter",
                        "regex"
                      ]
                    },
                    "value": {
                      "type": "string"
                    },
                    "caseSensitive": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "column",
                    "op",
                    "value",
                    "caseSensitive"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "op",
              "mode",
              "conditions"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "select"
              },
              "columns": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema9"
                }
              }
            },
            "required": [
              "op",
              "columns"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "order"
              },
              "by": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "column": {
                      "$ref": "#/$defs/__schema9"
                    },
                    "descending": {
                      "type": "boolean"
                    },
                    "numeric": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "column",
                    "descending",
                    "numeric"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "op",
              "by"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "$ref": "#/$defs/__schema13"
              },
              "rows": {
                "$ref": "#/$defs/__schema14"
              },
              "op": {
                "type": "string",
                "const": "sample"
              }
            },
            "required": [
              "method",
              "rows",
              "op"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "$ref": "#/$defs/__schema15"
              },
              "rows": {
                "$ref": "#/$defs/__schema14"
              },
              "seed": {
                "$ref": "#/$defs/__schema16"
              },
              "op": {
                "type": "string",
                "const": "sample"
              }
            },
            "required": [
              "method",
              "rows",
              "seed",
              "op"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "$ref": "#/$defs/__schema17"
              },
              "percent": {
                "$ref": "#/$defs/__schema18"
              },
              "seed": {
                "$ref": "#/$defs/__schema16"
              },
              "op": {
                "type": "string",
                "const": "sample"
              }
            },
            "required": [
              "method",
              "percent",
              "seed",
              "op"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "__schema13": {
      "type": "string",
      "const": "first"
    },
    "__schema14": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000,
      "$ref": "#/$defs/__schema7"
    },
    "__schema15": {
      "type": "string",
      "const": "random"
    },
    "__schema16": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "__schema17": {
      "type": "string",
      "const": "random"
    },
    "__schema18": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 100
    },
    "__schema19": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema2"
          },
          "kind": {
            "type": "string",
            "enum": [
              "extract",
              "chart",
              "report"
            ]
          },
          "recipeId": {
            "$ref": "#/$defs/__schema2"
          },
          "path": {
            "$ref": "#/$defs/__schema6"
          },
          "bytes": {
            "$ref": "#/$defs/__schema7"
          },
          "sha256": {
            "$ref": "#/$defs/__schema8"
          },
          "createdAt": {
            "$ref": "#/$defs/__schema4"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "sourceSha256": {
                "$ref": "#/$defs/__schema8"
              },
              "executedAt": {
                "$ref": "#/$defs/__schema4"
              },
              "engine": {
                "type": "object",
                "properties": {
                  "app": {
                    "type": "string"
                  },
                  "contract": {
                    "type": "string"
                  },
                  "semantics": {
                    "minimum": 1,
                    "$ref": "#/$defs/__schema7"
                  }
                },
                "required": [
                  "app",
                  "contract",
                  "semantics"
                ],
                "additionalProperties": false
              },
              "coverage": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "matched": {
                        "$ref": "#/$defs/__schema7"
                      },
                      "scanned": {
                        "$ref": "#/$defs/__schema7"
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "full",
                          "filtered"
                        ]
                      },
                      "total": {
                        "$ref": "#/$defs/__schema7"
                      },
                      "complete": {
                        "type": "boolean",
                        "const": true
                      }
                    },
                    "required": [
                      "matched",
                      "scanned",
                      "kind",
                      "total",
                      "complete"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "matched": {
                        "$ref": "#/$defs/__schema7"
                      },
                      "scanned": {
                        "$ref": "#/$defs/__schema7"
                      },
                      "kind": {
                        "type": "string",
                        "const": "sample"
                      },
                      "total": {
                        "$ref": "#/$defs/__schema7"
                      },
                      "complete": {
                        "type": "boolean",
                        "const": true
                      },
                      "sampling": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "method": {
                                "$ref": "#/$defs/__schema13"
                              },
                              "rows": {
                                "$ref": "#/$defs/__schema14"
                              }
                            },
                            "required": [
                              "method",
                              "rows"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "method": {
                                "$ref": "#/$defs/__schema15"
                              },
                              "rows": {
                                "$ref": "#/$defs/__schema14"
                              },
                              "seed": {
                                "$ref": "#/$defs/__schema16"
                              }
                            },
                            "required": [
                              "method",
                              "rows",
                              "seed"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "method": {
                                "$ref": "#/$defs/__schema17"
                              },
                              "percent": {
                                "$ref": "#/$defs/__schema18"
                              },
                              "seed": {
                                "$ref": "#/$defs/__schema16"
                              }
                            },
                            "required": [
                              "method",
                              "percent",
                              "seed"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "required": [
                      "matched",
                      "scanned",
                      "kind",
                      "total",
                      "complete",
                      "sampling"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "matched": {
                        "$ref": "#/$defs/__schema7"
                      },
                      "scanned": {
                        "$ref": "#/$defs/__schema7"
                      },
                      "kind": {
                        "type": "string",
                        "const": "sample"
                      },
                      "complete": {
                        "type": "boolean",
                        "const": false
                      }
                    },
                    "required": [
                      "matched",
                      "scanned",
                      "kind",
                      "complete"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "fidelity": {
                "type": "object",
                "properties": {
                  "level": {
                    "type": "string",
                    "enum": [
                      "bytes",
                      "values"
                    ]
                  },
                  "normalization": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "irregularRows": {
                    "$ref": "#/$defs/__schema7"
                  }
                },
                "required": [
                  "level",
                  "normalization",
                  "irregularRows"
                ],
                "additionalProperties": false
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "chain": {
                "minItems": 1,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema2"
                }
              },
              "recipeSha256": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/__schema2"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema8"
                }
              }
            },
            "required": [
              "sourceSha256",
              "executedAt",
              "engine",
              "coverage",
              "fidelity",
              "warnings"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "recipeId",
          "path",
          "bytes",
          "sha256",
          "createdAt",
          "provenance"
        ],
        "additionalProperties": false
      }
    }
  },
  "$comment": "El validador de FreyaLab también verifica rutas, referencias entre registros y profundidad de recetas."
}
