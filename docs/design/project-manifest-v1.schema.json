              "delimiter": {
                "type": "string",
                "enum": [
                  ",",
                  ";",
                  "\t",
                  "|"
                ]
              },
              "header": {
                "type": "boolean"
              },
              "eol": {
                "type": "string",
                "enum": [
                  "\n",
                  "\r\n",
                  "\r"
                ]
              },
              "finalEol": {
                "type": "boolean"
              }
