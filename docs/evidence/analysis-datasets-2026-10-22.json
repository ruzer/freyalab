    "memory": "25 ms observations of summed Electron working sets; shared pages may be counted twice; host process separately observed before/after; not exclusive RSS or guaranteed peak",
    "querySQL": [
      "WITH preparada AS (SELECT * FROM datos WHERE \"Ciudad\" = 'Oaxaca' AND TRY_CAST(\"Total\" AS DECIMAL(38,2)) >= 50) SELECT COUNT(*) AS filas,SUM(CAST(\"Total\" AS DECIMAL(38,2))) AS total,COUNT(DISTINCT \"Código\") AS distintos,COUNT(*) FILTER(WHERE \"Opcional\" IS NULL) AS ausentes,COUNT(*) FILTER(WHERE \"Opcional\" = '') AS vacios FROM preparada",
      "WITH preparada AS (SELECT * FROM datos WHERE \"Ciudad\" = 'Oaxaca' AND TRY_CAST(\"Total\" AS DECIMAL(38,2)) >= 50) SELECT \"Ciudad\",SUM(CAST(\"Total\" AS DECIMAL(38,2))) AS total FROM preparada GROUP BY \"Ciudad\" ORDER BY \"Ciudad\"",
      "WITH preparada AS (SELECT * FROM datos WHERE \"Ciudad\" = 'Puebla' AND TRY_CAST(\"Total\" AS DECIMAL(38,2)) >= 50) SELECT \"Ciudad\",SUM(CAST(\"Total\" AS DECIMAL(38,2))) AS total FROM preparada GROUP BY \"Ciudad\" ORDER BY \"Ciudad\""
    ]
  },
