+// Sonda temporal CI222, solo en el proceso de prueba; no sustituye resultados reales.
+async function armCsvPageRace(){
+ if(process.env.FREYALAB_CI222_CSV_PROBE!=='1')return
+ await app.evaluate(({ipcMain})=>{
+  type Handler=(event:Electron.IpcMainInvokeEvent,...args:unknown[])=>Promise<unknown>
+  type Held={event:Electron.IpcMainInvokeEvent;args:unknown[];resolve:(value:unknown)=>void;reject:(reason:unknown)=>void;started?:Promise<unknown>}
+  const handlers=(ipcMain as Electron.IpcMain&{_invokeHandlers:Map<string,Handler>})._invokeHandlers,original=handlers.get('freya')!
+  const events:{sequence:number;event:string;query?:unknown;error?:string}[]=[]
+  const log=(event:string,query?:unknown,error?:string)=>events.push({sequence:events.length+1,event,...query===undefined?{}:{query},...error===undefined?{}:{error}})
+  let first:Held|undefined,target='',released=false
+  const startUI=()=>{
+   if(!first)return undefined
+   if(first.started)return first.started
+   const held=first;log('ui:start',held.args[2]);held.started=original(held.event,...held.args)
+   void held.started.then(value=>{log('ui:success');held.resolve(value)},error=>{log('ui:error',undefined,String(error));held.reject(error)})
+   return held.started
+  }
+  const probe={events,get held(){return !!first&&!first.started},get started(){return !!first?.started},get target(){return target},releaseUI:()=>{released=true;log('release:external');startUI()}}
+  Reflect.set(globalThis,'ci222CsvProbe',probe)
+  handlers.set('freya',async(event,...args)=>{
+   const query=args[2] as {limit?:number;requestId?:number}|undefined
+   if(args[0]==='page'&&query?.limit===200&&!target){
+    target=String(args[1]);log('ui:held',query)
+    if(released)return original(event,...args)
+    return new Promise<unknown>((resolve,reject)=>{first={event,args,resolve,reject}})
+   }
+   if(args[0]==='page'&&String(args[1])===target&&query?.limit===10){
+    log('auxiliary:arrived',query)
+    if(first&&!first.started){
+     // Encola ambas peticiones reales al worker en el mismo turno. El auxiliar
+     // aumenta el ticket y cancela UI; no se inventa ningún resultado o error.
+     const ui=startUI()!,auxiliary=original(event,...args)
+     const outcomes=await Promise.allSettled([ui,auxiliary]);log('pair:settled')
+     if(outcomes[1].status==='rejected'){log('auxiliary:error',undefined,String(outcomes[1].reason));throw outcomes[1].reason}
+     log('auxiliary:success');return outcomes[1].value
+    }
+    try{const result=await original(event,...args);log('auxiliary:success');return result}
+    catch(error){log('auxiliary:error',undefined,String(error));throw error}
+   }
+   return original(event,...args)
+  })
+ })
+}
+async function observeCsvPageRace(info:{attach:(name:string,options:{body:string;contentType:string})=>Promise<void>}){
+ if(process.env.FREYALAB_CI222_CSV_PROBE!=='1')return
+ const probe=await app.evaluate(()=>{
+  const probe=Reflect.get(globalThis,'ci222CsvProbe')
+  return probe?{events:probe.events,held:probe.held,started:probe.started,target:probe.target}:null
+ }).catch(()=>null)
+ if(!probe)return
+ const dom=await page.evaluate(()=>({
+  warning:document.querySelector('.csv-workspace .warning-banner')?.textContent,
+  rows:document.querySelectorAll('.csv-scroll .csv-row').length,
+  toast:document.querySelector('.toast')?.textContent,
+  status:document.querySelector('.csv-status')?.textContent,
+  headerEditDisabled:(document.querySelector('[aria-label="Editar encabezado 1"]') as HTMLButtonElement|null)?.disabled,
+ })).catch(error=>({error:String(error)}))
+ const body=JSON.stringify({probe,dom},null,2);console.log('[ci222-csv-probe] '+body)
+ await info.attach('ci222-csv-probe',{body,contentType:'application/json'})
+ // La señal existe independientemente de que llegue o no la lectura auxiliar.
+ await app.evaluate(()=>Reflect.get(globalThis,'ci222CsvProbe')?.releaseUI()).catch(()=>{})
+}
